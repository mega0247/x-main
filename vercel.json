{
  "version": 2,
  "rewrites": [
    { "source": "/next.php/submit-result", "destination": "/api/submit-result" },
    { "source": "/next.php/session-open", "destination": "/api/session-open" },
    { "source": "/next.php/status/:sessionId", "destination": "/api/status?sessionId=:sessionId" },
    { "source": "/next.php/telegram-webhook", "destination": "/api/webhook" },
    { "source": "/next.php/config", "destination": "/api/config" },
    { "source": "/check.php", "destination": "/api/check" },
    { "source": "/redirect.php", "destination": "/redirect.html" },
    { "source": "/rejectnumber.php", "destination": "/rejectnumber.html" }
  ]
}
